# SQLite paths are relative to prisma/schema.prisma. Use durable storage in deployment.
DATABASE_URL="file:./dev.db"
# Exact canonical browser origin; HTTPS is required in production. No trailing path.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Generate a random secret (at least 32 bytes) before running Auth.js.
AUTH_SECRET=""
# Set only behind a trusted proxy that strips/replaces x-real-ip.
TRUST_PROXY="false"
# AUTH_TRUST_HOST=true may be needed on a deployment with a trusted canonical host.
# AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required in production for registration, verification and password reset.
# Development/test without these writes private .outbox/*.json files.
RESEND_API_KEY=""
EMAIL_FROM=""

PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Required for the change action. Configure eligible catalog prices in Stripe Portal.
STRIPE_PORTAL_CONFIGURATION_ID=""

# Optional one-time administrator bootstrap; unset after seed. No default credentials.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
